# 复制到工程根目录 .env 后填写本机配置。模型未配置时其他编辑功能仍可使用。
APP_HOST=127.0.0.1
APP_WEB_PORT=5173
APP_PORT=8000
APP_CONNECT_HOST=127.0.0.1
APP_STARTUP_TIMEOUT=15
APP_PROXY_TIMEOUT=1800
APP_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
APP_DEBUG=false
APP_LLM_BASE_URL=
APP_LLM_MODEL=
APP_LLM_API_KEY=
APP_LLM_AUTH_TYPE=bearer
APP_LLM_TEMPERATURE=0.0
APP_LLM_MAX_TOKENS=1024
APP_LLM_TIMEOUT=30
APP_FORCE_REFRESH=false
APP_USE_BUNDLED_VENDOR=false
APP_PIPELINE_PYTHON=
APP_PIPELINE_SCRIPT=
APP_OUTPUT_ROOT=
APP_LEDIT_EXE=
APP_LEDIT_SEARCH_ROOTS=
